import { Suspense } from "react"
import { notFound, redirect } from "next/navigation"
import Link from "next/link"
import { 
  ArrowLeft, 
  ArrowRight,
  Clock, 
  CheckCircle, 
  Circle,
  Play,
  Book,
  ChevronLeft,
  ChevronRight
} from "lucide-react"

import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Progress } from "@/components/ui/progress"
import { Separator } from "@/components/ui/separator"
import { FadeIn } from "@/components/cult/fade-in"

import { getCourseWithUserProgress, getNextLesson } from "@/app/actions/courses"
import InteractiveLessonViewer from "@/components/interactive-lesson-viewer"

export const dynamic = "force-dynamic"

interface LearnPageProps {
  params: {
    slug: string
  }
  searchParams: {
    lesson?: string
  }
}

export default async function LearnPage({ params, searchParams }: LearnPageProps) {
  const courseData = await getCourseWithUserProgress(params.slug)
  
  if (!courseData) {
    notFound()
  }

  const { userEnrollment, userProgress, chapters, ...course } = courseData

  // If user is not enrolled, redirect to course overview
  if (!userEnrollment) {
    redirect(`/courses/${params.slug}`)
  }

  // Get current lesson or find next lesson
  let currentLessonId = searchParams.lesson
  
  if (!currentLessonId) {
    currentLessonId = await getNextLesson(course.id)
    if (currentLessonId) {
      redirect(`/courses/${params.slug}/learn?lesson=${currentLessonId}`)
    }
  }

  // Find current lesson details
  let currentLesson: any = null
  let currentChapter: any = null
  let lessonIndex = 0
  let totalLessons = 0

  for (const chapter of chapters || []) {
    for (const lesson of chapter.lessons || []) {
      totalLessons++
      if (lesson.id === currentLessonId) {
        currentLesson = lesson
        currentChapter = chapter
      }
      if (!currentLesson) {
        lessonIndex++
      }
    }
  }

  if (!currentLesson || !currentChapter) {
    notFound()
  }

  // Get lesson progress
  const lessonProgress = userProgress.find(p => p.lesson_id === currentLessonId)

  // Calculate overall progress
  const completedLessons = userProgress.filter(p => p.is_completed).length
  const overallProgress = totalLessons > 0 ? (completedLessons / totalLessons) * 100 : 0

  // Find previous and next lessons
  const allLessons: any[] = []
  for (const chapter of chapters || []) {
    for (const lesson of chapter.lessons || []) {
      allLessons.push({ ...lesson, chapter })
    }
  }

  const currentLessonGlobalIndex = allLessons.findIndex(l => l.id === currentLessonId)
  const prevLesson = currentLessonGlobalIndex > 0 ? allLessons[currentLessonGlobalIndex - 1] : null
  const nextLesson = currentLessonGlobalIndex < allLessons.length - 1 ? allLessons[currentLessonGlobalIndex + 1] : null

  return (
    <div className="min-h-screen bg-background" dir="rtl">
      {/* Header Navigation */}
      <div className="border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50">
        <div className="container mx-auto px-4 py-3">
          <div className="flex items-center gap-4">
            <Button variant="ghost" size="icon" asChild>
              <Link href={`/courses/${params.slug}`}>
                <ArrowLeft className="h-4 w-4" />
              </Link>
            </Button>
            <div className="flex-1 min-w-0">
              <h1 className="text-lg font-semibold truncate">{course.title_ar}</h1>
              <p className="text-sm text-muted-foreground">
                {currentChapter.title_ar} • الدرس {lessonIndex + 1} من {totalLessons}
              </p>
            </div>
            <div className="flex items-center gap-2">
              <div className="hidden sm:flex items-center gap-2">
                <span className="text-sm text-muted-foreground">
                  {Math.round(overallProgress)}% مكتمل
                </span>
                <Progress value={overallProgress} className="w-20" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div className="container mx-auto px-4 py-6 max-w-7xl">
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
          {/* Main Content */}
          <div className="lg:col-span-3">
            <FadeIn>
              <Card>
                <CardHeader>
                  <div className="flex items-center justify-between">
                    <div>
                      <CardTitle>{currentLesson.title_ar}</CardTitle>
                      <p className="text-sm text-muted-foreground mt-1">
                        {currentChapter.title_ar}
                      </p>
                    </div>
                    <div className="flex items-center gap-2">
                      {lessonProgress?.is_completed && (
                        <Badge className="bg-green-100 text-green-800">
                          <CheckCircle className="h-3 w-3 mr-1" />
                          مكتمل
                        </Badge>
                      )}
                      <Badge variant="outline">
                        {currentLesson.lesson_type === 'video' ? 'فيديو' : 'قراءة'}
                      </Badge>
                    </div>
                  </div>
                </CardHeader>
                <CardContent>
                  <InteractiveLessonViewer 
                    lesson={currentLesson}
                    courseId={course.id}
                    isCompleted={lessonProgress?.is_completed || false}
                    progress={lessonProgress?.progress_percentage || 0}
                  />
                </CardContent>
              </Card>

              {/* Navigation */}
              <div className="flex items-center justify-between mt-6">
                <div>
                  {prevLesson && (
                    <Button variant="outline" asChild>
                      <Link href={`/courses/${params.slug}/learn?lesson=${prevLesson.id}`}>
                        <ChevronRight className="h-4 w-4 mr-2" />
                        الدرس السابق
                      </Link>
                    </Button>
                  )}
                </div>
                <div>
                  {nextLesson && (
                    <Button asChild>
                      <Link href={`/courses/${params.slug}/learn?lesson=${nextLesson.id}`}>
                        الدرس التالي
                        <ChevronLeft className="h-4 w-4 ml-2" />
                      </Link>
                    </Button>
                  )}
                </div>
              </div>
            </FadeIn>
          </div>

          {/* Sidebar */}
          <div className="lg:col-span-1">
            <div className="sticky top-24 space-y-4">
              {/* Course Progress */}
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">التقدم العام</CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-3">
                    <div className="flex items-center justify-between">
                      <span className="text-sm">الدروس المكتملة</span>
                      <span className="text-sm font-medium">{completedLessons} من {totalLessons}</span>
                    </div>
                    <Progress value={overallProgress} className="h-2" />
                    <div className="flex items-center justify-between">
                      <span className="text-sm text-muted-foreground">وقت الدراسة</span>
                      <span className="text-sm">
                        {Math.round(userEnrollment.total_study_time_minutes)} دقيقة
                      </span>
                    </div>
                  </div>
                </CardContent>
              </Card>

              {/* Course Outline */}
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">محتوى الدورة</CardTitle>
                </CardHeader>
                <CardContent className="space-y-3">
                  {chapters?.map((chapter: any) => (
                    <div key={chapter.id} className="space-y-2">
                      <h4 className="font-medium text-sm text-right">{chapter.title_ar}</h4>
                      <div className="space-y-1">
                        {chapter.lessons?.map((lesson: any) => {
                          const lessonProg = userProgress.find(p => p.lesson_id === lesson.id)
                          const isCurrentLesson = lesson.id === currentLessonId
                          
                          return (
                            <Link 
                              key={lesson.id}
                              href={`/courses/${params.slug}/learn?lesson=${lesson.id}`}
                              className={`flex items-center justify-between p-2 rounded-md transition-colors ${
                                isCurrentLesson 
                                  ? 'bg-primary/10 border border-primary/20' 
                                  : 'hover:bg-muted/50'
                              }`}
                            >
                              <div className="flex items-center gap-2">
                                {lessonProg?.is_completed ? (
                                  <CheckCircle className="h-4 w-4 text-green-500" />
                                ) : (
                                  <Circle className="h-4 w-4 text-muted-foreground" />
                                )}
                                <span className="text-sm">{lesson.title_ar}</span>
                              </div>
                              <div className="flex items-center gap-1 text-xs text-muted-foreground">
                                {lesson.lesson_type === 'video' ? (
                                  <Play className="h-3 w-3" />
                                ) : (
                                  <Book className="h-3 w-3" />
                                )}
                                <span>
                                  {lesson.video_duration_seconds 
                                    ? Math.ceil(lesson.video_duration_seconds / 60) 
                                    : (lesson.estimated_reading_time || 5)
                                  }د
                                </span>
                              </div>
                            </Link>
                          )
                        })}
                      </div>
                    </div>
                  ))}
                </CardContent>
              </Card>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}